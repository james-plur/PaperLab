# LLM credentials (configure only the provider you use)
ZHIPU_API_KEY=
OPENAI_API_KEY=

# Web authentication and HTTPS
PAPERLAB_ADMIN_PASSWORD_HASH=
PAPERLAB_ADMIN_USERNAME=admin
PAPERLAB_LOCAL_TRUSTED_MODE=1
PAPERLAB_COOKIE_SECURE=0
PAPERLAB_ADDRESS=https://62.234.193.237

# Incremental replica synchronization (local device only)
PAPERLAB_SYNC_URL=
PAPERLAB_DEVICE_ID=
PAPERLAB_DEVICE_TOKEN=
PAPERLAB_SYNC_SERVER=0

# Private S3-compatible data storage. For Cloudflare R2, region is `auto`.
PAPERLAB_SYNC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
PAPERLAB_SYNC_BUCKET=paperlab-data
PAPERLAB_SYNC_REGION=auto
PAPERLAB_SYNC_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
