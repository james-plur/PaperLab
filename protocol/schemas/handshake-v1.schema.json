{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperlab.invalid/protocol/handshake-v1.schema.json",
  "title": "PaperLab sync handshake v1",
  "type": "object",
  "required": ["protocol_version", "app_version", "schema_version", "capabilities"],
  "properties": {
    "protocol_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "app_version": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
