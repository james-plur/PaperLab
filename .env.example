# Copy to .env and fill in. paperlab reads these via your shell environment.
export OPENAI_API_KEY="sk-..."

# Optional: point at a compatible proxy or alternate base URL.
# export OPENAI_BASE_URL="http://127.0.0.1:15721/v1"

# Semantic Scholar API key (optional but recommended). Without a key, requests
# share a 1000 RPS anonymous pool that can be throttled during peak hours.
# With a key you get a dedicated 1 RPS limit, which pairs well with the batch
# endpoint (500 papers per request). Request one at:
# https://www.semanticscholar.org/product/api#api-key
# export S2_API_KEY=""
