{
  "name": "paperlab-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "PaperLab macOS research workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "package:mac": "bash scripts/package-mac.sh",
    "pack:mac": "npm run build:web && npm run build:sidecar && electron-builder --mac dir --x64"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.11",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.paperlab.desktop",
    "productName": "PaperLab",
    "protocols": [
      {
        "name": "PaperLab Paper Link",
        "schemes": ["paperlab"]
      }
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "renderer-dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar/paperlab-sidecar",
        "to": "sidecar/paperlab-sidecar"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "PaperLab ${version}",
      "artifactName": "PaperLab-${version}-${arch}.${ext}"
    }
  }
}
